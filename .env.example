# NovaBrain Sentinel — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env with real credentials.
# Every variable below has a safe built-in default; blank means "use the default".

# Application
SENTINEL_HOST=          # default 0.0.0.0
SENTINEL_PORT=          # default 8000
SENTINEL_LOG_LEVEL=     # default info
SENTINEL_ENV=           # default production

# NVIDIA AI Platform — read by the model-integration task, unused by this slice.
# Leave these blank; never commit real keys.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
