# NovaBrain Sentinel — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env with real credentials.
# SENTINEL_* variables have safe built-in defaults; blank means "use the default".

# Application
SENTINEL_HOST=          # default 0.0.0.0
SENTINEL_PORT=          # default 8000
SENTINEL_LOG_LEVEL=     # default info
SENTINEL_ENV=           # default production

# NVIDIA Build — required by POST /api/v1/incidents/analyze.
# GET / and GET /health work without these; the analyze endpoint returns 503 until they are set.
# The API key is a secret: supply it from the environment or a platform secret store at run time.
NVIDIA_API_KEY=                     # required, no default — never commit a real value
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # optional; this is the default
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b    # required, no default

# Machine event ingestion — required only by POST /api/v1/events/ingest.
# A bearer secret a producer (e.g. NovaOps or the demo emitter) presents as
# "Authorization: Bearer <token>". Without it the route answers
# 503 ingest_not_configured; the console and POST /api/v1/incidents/analyze
# keep working and stay unauthenticated by design.
# Generate one at run time (e.g. `openssl rand -hex 32`) and never commit it.
SENTINEL_INGEST_TOKEN=
